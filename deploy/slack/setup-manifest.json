{
  "display_information": {
    "name": "Junction Unc",
    "description": "Request business work through your connected Junction routines."
  },
  "features": {
    "bot_user": {
      "display_name": "Unc",
      "always_online": false
    }
  },
  "oauth_config": {
    "redirect_urls": [
      "https://junction-unc.vercel.app/api/channels/slack/callback"
    ],
    "scopes": {
      "bot": [
        "chat:write",
        "im:history",
        "im:write",
        "im:read",
        "app_mentions:read",
        "users:read",
        "channels:read",
        "groups:read"
      ]
    }
  },
  "settings": {
    "interactivity": { "is_enabled": false },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
