{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    { "path": "/api/flow-tick", "schedule": "0 20 * * *" }
  ],
  "redirects": [
    { "source": "/login", "destination": "https://app.getjunction.ai/login" },
    { "source": "/signin", "destination": "https://app.getjunction.ai/signin" },
    { "source": "/sign-in", "destination": "https://app.getjunction.ai/login" },
    { "source": "/app", "destination": "https://app.getjunction.ai/" },
    { "source": "/app/:path*", "destination": "https://app.getjunction.ai/:path*" },
    { "source": "/dashboard", "destination": "https://app.getjunction.ai/dashboard" },
    { "source": "/account", "destination": "https://app.getjunction.ai/account" },
    { "source": "/portal", "destination": "https://app.getjunction.ai/" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
